<?xml version="1.0" encoding="utf-8"?>
<!--
  A reticle over a meridian: the app's one idea, looking closely at a place.
  Drawn as a vector so it scales to every density without shipping six
  bitmaps, and kept inside the 72dp safe zone adaptive icons mask to.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Globe outline -->
    <path
        android:strokeColor="#2FD4C8"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:pathData="M54,28 a26,26 0 1,0 0.1,0 z" />
    <!-- Meridian -->
    <path
        android:strokeColor="#2FD4C8"
        android:strokeWidth="2"
        android:strokeAlpha="0.75"
        android:fillColor="#00000000"
        android:pathData="M54,28 a13,26 0 1,0 0.1,0 z" />
    <!-- Equator -->
    <path
        android:strokeColor="#2FD4C8"
        android:strokeWidth="2"
        android:strokeAlpha="0.75"
        android:fillColor="#00000000"
        android:pathData="M28,54 L80,54" />

    <!-- Reticle ticks -->
    <path android:fillColor="#F4B740" android:pathData="M54,20 L54,30 L56,30 L56,20 z" />
    <path android:fillColor="#F4B740" android:pathData="M54,78 L54,88 L56,88 L56,78 z" />
    <path android:fillColor="#F4B740" android:pathData="M20,54 L30,54 L30,56 L20,56 z" />
    <path android:fillColor="#F4B740" android:pathData="M78,54 L88,54 L88,56 L78,56 z" />
    <!-- Centre mark -->
    <path
        android:fillColor="#F4B740"
        android:pathData="M54,51 a3.5,3.5 0 1,0 0.1,0 z" />
</vector>
